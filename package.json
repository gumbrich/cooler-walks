{
  "name": "cooler-walks",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "data:prepare": "tsx scripts/prepare-data.ts && npm run data:prepare:traffic && npm run data:attach:counts && npm run data:prepare:addresses && node --import tsx scripts/attach-detailed-shade.ts",
    "data:verify": "tsx scripts/verify-data.ts && tsx scripts/verify-cities.ts && tsx scripts/verify-coverage.ts && tsx scripts/verify-arrival-shade.ts && node --import tsx scripts/verify-detailed-shade.ts && node --import tsx scripts/verify-traffic.ts && npm run data:verify:shade-library && npm run data:verify:pavements && npm run data:verify:startup && npm run data:verify:canopy",
    "data:audit-trees": "tsx scripts/audit-trees.ts",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:prepare:cities": "tsx scripts/prepare-cities.ts",
    "native:sync": "npm run build && node scripts/native-icons.mjs && node scripts/native-sync.mjs",
    "native:ios": "node scripts/native-build.mjs ios",
    "native:android": "node scripts/native-build.mjs android",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "test:native:android": "node scripts/verify-android.mjs",
    "data:packs": "node --import tsx scripts/build-area-packs.ts",
    "predev": "npm run data:packs",
    "prebuild": "npm run data:packs",
    "native:sync:lite": "npm run native:sync -- --lite",
    "data:serve": "node scripts/serve-packs.mjs",
    "precheck": "npm run data:packs",
    "pretest": "npm run data:packs",
    "test:native:downloads": "node scripts/verify-android-downloads.mjs",
    "test:native:pages": "node scripts/verify-android-public-pages.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:prepare": "npm run check && npm run build && npm run release:check -- --allow-draft && node scripts/package-release.mjs",
    "release:smoke": "node scripts/verify-hosted.mjs",
    "release:serve": "node scripts/serve-release.mjs",
    "test:release:browser": "playwright test --config playwright.release.config.ts",
    "native:bundle:unsigned": "node scripts/native-build.mjs android-bundle-unsigned",
    "native:bundle": "npm run native:sync && npm run release:check -- --native && node scripts/native-build.mjs android-bundle",
    "native:archive:unsigned": "node scripts/native-build.mjs ios-archive-unsigned",
    "native:archive": "npm run native:sync && npm run release:check -- --native && node scripts/native-build.mjs ios-archive",
    "data:fetch:traffic": "node scripts/fetch-traffic.mjs",
    "data:prepare:traffic": "tsx scripts/prepare-traffic.ts && npm run data:prepare:traffic:zones",
    "data:attach:counts": "node --import tsx scripts/attach-vehicle-counts.ts",
    "test:native:counts": "node scripts/verify-android-counts.mjs",
    "data:prepare:addresses": "tsx scripts/prepare-zurich-addresses.ts",
    "data:fetch:zurich": "python3 scripts/fetch-zurich-expansion.py",
    "data:prepare:shade": ".venv-geo/bin/python scripts/prepare-shade-library.py && node --import tsx scripts/attach-detailed-shade.ts",
    "data:fetch:shade": ".venv-geo/bin/python scripts/fetch-zurich-shade-library.py",
    "data:verify:shade-library": "node --import tsx scripts/verify-shade-library.ts",
    "data:fetch:traffic:zones": "node --import tsx scripts/fetch-cantonal-traffic.ts",
    "data:prepare:traffic:zones": "node --import tsx scripts/prepare-traffic-zones.ts",
    "data:fetch:pavements": "node --import tsx scripts/fetch-pavements.ts",
    "data:prepare:pavements": "node --import tsx scripts/prepare-pavements.ts",
    "data:verify:pavements": "node --import tsx scripts/verify-pavements.ts && node --import tsx scripts/verify-pavement-expansion.ts",
    "data:audit:pavements": ".venv-geo/bin/python scripts/audit-pavement-shadows.py",
    "data:compare:pavements": ".venv-geo/bin/python scripts/compare-pavement-tools.py",
    "test:native:pavements": "node scripts/verify-android-pavements.mjs",
    "test:pwa:upgrade": "node scripts/verify-pwa-upgrade.mjs",
    "data:verify:startup": "node --import tsx scripts/verify-startup.ts",
    "data:prepare:canopy": ".venv-geo/bin/python scripts/prepare-canopy.py",
    "data:audit:canopy": ".venv-geo/bin/python scripts/audit-canopy-source.py",
    "data:verify:canopy": "node --import tsx scripts/verify-canopy.ts",
    "test:native:canopy": "node scripts/verify-android-canopy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.11.2",
    "proj4": "^2.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
