{
  "name": "cooler-walks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "data:prepare": "tsx scripts/prepare-data.ts",
    "data:verify": "tsx scripts/verify-data.ts",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.11.2",
    "proj4": "^2.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
