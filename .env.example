# Optional HTTPS directory containing the generated public/packs/*.cwp files.
# Browser builds default to /packs/ on the same site. Native builds without
# this setting keep their included areas; extra downloads are unavailable.
# VITE_AREA_BASE_URL=https://your-data-host.example/packs/

# Netlify Functions scope, all deploy contexts. Never prefix these with VITE_.
# CW_SITE_PASSWORD=enter-the-shared-password-in-Netlify
# CW_SESSION_SECRET=generate-at-least-32-random-bytes
